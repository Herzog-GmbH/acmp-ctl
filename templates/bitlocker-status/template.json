        "StoredCustomFields": "{\"StoredCustomFields\":[{\"Id\":\"{{CF:BitLockerStatus:FieldID}}\",\"ParentId\":\"{{CF:BitLockerStatus:TableID}}\",\"DisplayName_en\":\"BitLockerStatus\",\"DisplayName_de\":\"BitLockerStatus\",\"IsMultiField\":false,\"InputMethod\":\"imText\",\"MaxLength\":100,\"FieldHeight\":0,\"RangeMin\":0,\"RangeMax\":0,\"DecimalPlaces\":0,\"HasRange\":false}]}",
        "StoredTables": "{\"StoredTables\":[{\"Id\":\"{{CF:BitLockerStatus:TableID}}\",\"ParentId\":\"{{CF:BitLockerStatus:FolderID}}\",\"DisplayName\":\"Attribute\",\"IsMultiTable\":false}]}",
        "StoredFolders": "{\"StoredFolders\":[{\"Id\":\"{{CF:BitLockerStatus:FolderID}}\",\"ParentId\":\"{{CF:BitLockerStatus:FolderParentID}}\",\"DisplayName\":\"Client Info\"}]}"
      }
