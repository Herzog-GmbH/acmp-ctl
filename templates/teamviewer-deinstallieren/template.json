{
  "$schema": "../../schema/ctl-template-1.schema.json",
  "schema": "acmp-ctl/template@1",
  "id": "teamviewer-deinstallieren",
  "version": "1.0.0",
  "status": "entwurf",
  "name": "TeamViewer vollständig deinstallieren",
  "summary": "Deinstalliert alle TeamViewer-Versionen (Vollversion, Host, MSI und Setup) still und räumt Reste auf: Dienste, geplante Aufgaben und Programmordner, auf Wunsch auch Einstellungen in Registry und Benutzerprofilen.",
  "description": "## So funktioniert es\n1. Sucht TeamViewer-Einträge in der Softwareliste (64 und 32 Bit sowie in den Profilen angemeldeter Benutzer).\n2. Stoppt TeamViewer-Dienste und beendet die Programme.\n3. MSI-Einträge: `msiexec /x {ProduktCode} /qn /norestart`. Andere: eigenes Deinstallationsprogramm mit `/S`. Gibt es keinen Eintrag, aber noch einen Programmordner, wird dessen `uninstall.exe /S` genutzt.\n4. Wartet bis zu 2 Minuten, weil TeamViewer die Deinstallation als Kopie im Hintergrund fortsetzt.\n5. Entfernt Reste: Dienste (`sc delete`), geplante Aufgaben, Programmordner. Bei `EINSTELLUNGEN_LOESCHEN` = ja auch `HKLM\\SOFTWARE\\TeamViewer`, die Benutzerschlüssel und `AppData\\…\\TeamViewer` in allen Profilen.\n6. Prüft, ob noch ein Eintrag oder Dienst übrig ist.\n\n## Ergebnis/Exitcodes\n- 0 = deinstalliert\n- 20 = war nicht installiert\n- 5 = Eintrag oder Dienst noch vorhanden\n- 1 = sonstiger Fehler\n\nBei 0 und 20 endet der Command erfolgreich, sonst mit Fehler.\n\n## Hinweise\n- Eine laufende TeamViewer-Sitzung bricht sofort ab. Den Command also nicht über TeamViewer selbst auslösen.\n- Mit `EINSTELLUNGEN_LOESCHEN` = ja gehen auch Kontoverknüpfung, Zuweisung und gespeicherte Verbindungen verloren.\n- Protokoll: `C:\\Windows\\Temp\\acmp-teamviewer-uninstall.log`, MSI-Protokolle daneben.\n- Einen Neustart löst der Command nie aus.",
  "author": {
    "name": "herzog GmbH",
    "github": "Herzog-GmbH"
  },
  "license": "MIT",
  "updated": "2026-10-16",
  "category": "Software",
  "tags": [
    "TeamViewer",
    "Deinstallation",
    "Fernwartung",
    "Bereinigung",
    "MSI"
  ],
  "applications": [
    {
      "name": "TeamViewer",
      "vendor": "TeamViewer"
    }
  ],
  "acmp": {
    "minVersion": "6.10",
    "scriptFormat": 13,
    "exportedWith": "6.10.4"
  },
  "parameters": [
    {
      "name": "EINSTELLUNGEN_LOESCHEN",
      "description": "ja = auch Einstellungen in Registry und Benutzerprofilen löschen, nein = Einstellungen behalten",
      "default": "ja",
      "required": true
    }
  ],
  "requires": {
    "customFields": [],
    "globalAccount": null,
    "notes": [
      "Läuft als Dienst (SYSTEM). Ein angemeldeter Benutzer ist nicht nötig, es gibt keine Meldungen.",
      "Kein Neustart. Braucht die MSI-Deinstallation einen, steht Code 3010 im Protokoll."
    ]
  },
  "variables": [
    {
      "name": "TV_EINSTELLUNGEN_LOESCHEN",
      "value": "{{EINSTELLUNGEN_LOESCHEN}}"
    },
    {
      "name": "UNINSTALL_EXITCODE",
      "value": "-1"
    }
  ],
  "steps": [
    {
      "class": "TExecutePowerShell",
      "description": "TeamViewer deinstallieren und Reste entfernen (als SYSTEM)",
      "fields": {
        "_CommandComment": "Läuft als SYSTEM. Deinstalliert alle TeamViewer-Einträge still, entfernt Reste und prüft das Ergebnis. Rückgabe in UNINSTALL_EXITCODE (0 deinstalliert, 20 war nicht installiert, 5 noch vorhanden).",
        "BatchLines": [
          "# Alle TeamViewer-Versionen deinstallieren und Reste entfernen",
          "#",
          "# Laeuft als SYSTEM ueber ACMP (64-Bit-PowerShell).",
          "# Projektvariable TV_EINSTELLUNGEN_LOESCHEN: ja = auch Einstellungen in Registry und Benutzerprofilen loeschen.",
          "#",
          "# Ablauf:",
          "#  1. TeamViewer-Eintraege in der Softwareliste suchen (64 und 32 Bit, geladene Benutzerprofile)",
          "#  2. TeamViewer-Dienste und -Programme beenden",
          "#  3. MSI-Eintraege mit msiexec /x, alle anderen mit dem eigenen Deinstallationsprogramm und /S entfernen",
          "#  4. warten, bis die Deinstallation durch ist (TeamViewer laeuft als Kopie im Hintergrund weiter)",
          "#  5. Reste entfernen: Dienste, geplante Aufgaben, Programmordner; bei ja auch Einstellungen",
          "#  6. pruefen, ob nichts mehr in der Softwareliste steht und kein Dienst mehr da ist",
          "#",
          "# Rueckgabe: 0 deinstalliert, 20 war nicht installiert, 5 danach noch vorhanden, 1 sonstiger Fehler.",
          "# Protokoll: C:\\Windows\\Temp\\acmp-teamviewer-uninstall.log, MSI-Protokolle daneben",
          "",
          "$einstellungenLoeschen = @('ja', 'j', 'yes', '1', 'true') -contains '%TV_EINSTELLUNGEN_LOESCHEN%'.Trim().ToLower()",
          "$wartezeit = 600   # Sekunden je Deinstallationsprogramm",
          "",
          "$ErrorActionPreference = 'Stop'",
          "$logDatei = Join-Path $env:windir 'Temp\\acmp-teamviewer-uninstall.log'",
          "function Schreibe([string]$text) {",
          "    [Console]::Out.WriteLine($text)",
          "    try { Add-Content -LiteralPath $logDatei -Value ((Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + '  ' + $text) -Encoding UTF8 } catch { }",
          "}",
          "trap { Schreibe ('FEHLER 1: ' + $_.Exception.Message); exit 1 }",
          "",
          "function Benutzer-Hives {",
          "    @(Get-ChildItem -Path 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue |",
          "        Where-Object { $_.PSChildName -match '^S-1-(5-21|12-1)-[0-9-]+$' } | ForEach-Object { $_.PSChildName })",
          "}",
          "function Finde-Eintraege {",
          "    $schluessel = @('HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*',",
          "                    'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*')",
          "    foreach ($sid in Benutzer-Hives) { $schluessel += ('Registry::HKEY_USERS\\' + $sid + '\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*') }",
          "    @(Get-ItemProperty -Path $schluessel -ErrorAction SilentlyContinue |",
          "        Where-Object { $_.DisplayName -and ($_.DisplayName -match '^TeamViewer' -or ($_.DisplayName -match 'TeamViewer' -and [string]$_.Publisher -match 'TeamViewer')) })",
          "}",
          "function Finde-Dienste { @(Get-Service -ErrorAction SilentlyContinue | Where-Object { $_.Name -like 'TeamViewer*' -or $_.DisplayName -like 'TeamViewer*' }) }",
          "function Programmordner {",
          "    $o = @((Join-Path $env:ProgramFiles 'TeamViewer'))",
          "    if (${env:ProgramFiles(x86)}) { $o += (Join-Path ${env:ProgramFiles(x86)} 'TeamViewer') }",
          "    $o",
          "}",
          "function MSI-Code($eintrag) {",
          "    if ($eintrag.PSChildName -match '^\\{[0-9A-Fa-f\\-]{36}\\}$') { return $eintrag.PSChildName }",
          "    if ([string]$eintrag.UninstallString -match '(?i)msiexec[^{]*(\\{[0-9A-Fa-f\\-]{36}\\})') { return $Matches[1] }",
          "    return $null",
          "}",
          "function Teile-Befehl([string]$befehl) {",
          "    $befehl = $befehl.Trim()",
          "    if ($befehl.StartsWith('\"')) {",
          "        $ende = $befehl.IndexOf('\"', 1)",
          "        if ($ende -lt 0) { return @($befehl.Trim('\"'), '') }",
          "        return @($befehl.Substring(1, $ende - 1), $befehl.Substring($ende + 1).Trim())",
          "    }",
          "    $pos = $befehl.ToLower().IndexOf('.exe')",
          "    if ($pos -lt 0) { return @($befehl, '') }",
          "    return @($befehl.Substring(0, $pos + 4), $befehl.Substring($pos + 4).Trim())",
          "}",
          "function Starte([string]$programm, [string]$argumente) {",
          "    $p = Start-Process -FilePath $programm -ArgumentList $argumente -PassThru -WindowStyle Hidden",
          "    $null = $p.Handle",
          "    if (-not $p.WaitForExit($wartezeit * 1000)) {",
          "        Schreibe ('Zeitueberschreitung, beende ' + $programm)",
          "        Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue",
          "        return -1",
          "    }",
          "    return $p.ExitCode",
          "}",
          "function Stoppe-TeamViewer {",
          "    foreach ($d in Finde-Dienste) {",
          "        if ($d.Status -eq 'Stopped') { continue }",
          "        try { Stop-Service -Name $d.Name -Force -ErrorAction Stop; Schreibe ('Dienst gestoppt: ' + $d.Name) }",
          "        catch { Schreibe ('Dienst nicht gestoppt: ' + $d.Name + ': ' + $_.Exception.Message) }",
          "    }",
          "    foreach ($p in @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.ProcessName -like 'TeamViewer*' -or $_.ProcessName -in @('tv_w32', 'tv_x64') })) {",
          "        Schreibe ('Beende ' + $p.ProcessName + ' (PID ' + $p.Id + ')')",
          "        Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue",
          "    }",
          "}",
          "function Entferne([string]$pfad) {",
          "    if (-not (Test-Path -LiteralPath $pfad)) { return }",
          "    try { Remove-Item -LiteralPath $pfad -Recurse -Force -ErrorAction Stop; Schreibe ('Entfernt: ' + $pfad) }",
          "    catch { Schreibe ('Nicht entfernt: ' + $pfad + ': ' + $_.Exception.Message) }",
          "}",
          "",
          "Schreibe ('Start auf ' + $env:COMPUTERNAME + ', Einstellungen loeschen: ' + $einstellungenLoeschen)",
          "",
          "# 1. Suchen",
          "# Ergebnisse immer in @() packen: Bei genau einem Treffer fehlt in Windows PowerShell 5.1 sonst .Count",
          "$eintraege = @(Finde-Eintraege)",
          "$dienste = @(Finde-Dienste)",
          "$ordnerDa = @(Programmordner | Where-Object { Test-Path -LiteralPath $_ })",
          "if ($eintraege.Count -eq 0 -and $dienste.Count -eq 0 -and $ordnerDa.Count -eq 0) { Schreibe 'TeamViewer ist nicht installiert, nichts zu tun.'; exit 20 }",
          "foreach ($e in $eintraege) { Schreibe ('Gefunden: ' + $e.DisplayName + ' ' + $e.DisplayVersion + ' [' + $e.PSChildName + ']') }",
          "",
          "# 2. Beenden",
          "Stoppe-TeamViewer",
          "Start-Sleep -Seconds 2",
          "",
          "# 3. Deinstallieren",
          "foreach ($e in $eintraege) {",
          "    $code = MSI-Code $e",
          "    if ($code -and ([string]$e.WindowsInstaller -eq '1' -or [string]$e.UninstallString -match '(?i)msiexec')) {",
          "        $msiLog = Join-Path $env:windir ('Temp\\acmp-teamviewer-uninstall-' + $code.Trim('{}') + '.log')",
          "        Schreibe ('msiexec /x ' + $code)",
          "        Schreibe ('msiexec beendet mit Code ' + (Starte (Join-Path $env:windir 'System32\\msiexec.exe') ('/x ' + $code + ' /qn /norestart REBOOT=ReallySuppress /l*v \"' + $msiLog + '\"')))",
          "        continue",
          "    }",
          "    $befehl = if ($e.QuietUninstallString) { [string]$e.QuietUninstallString } else { [string]$e.UninstallString }",
          "    if (-not $befehl) { Schreibe ('Kein Deinstallationsbefehl fuer ' + $e.DisplayName); continue }",
          "    $teile = Teile-Befehl $befehl",
          "    $argumente = $teile[1]",
          "    if ($argumente -notmatch '(^|\\s)/S(\\s|$)') { $argumente = ($argumente + ' /S').Trim() }",
          "    if (-not (Test-Path -LiteralPath $teile[0])) { Schreibe ('Deinstallationsprogramm fehlt: ' + $teile[0]); continue }",
          "    Schreibe ('Deinstallationsprogramm: \"' + $teile[0] + '\" ' + $argumente)",
          "    Schreibe ('beendet mit Code ' + (Starte $teile[0] $argumente))",
          "}",
          "# Programmordner ohne Eintrag in der Softwareliste (z. B. defekte Installation): bekanntes uninstall.exe nutzen",
          "if ($eintraege.Count -eq 0) {",
          "    foreach ($o in Programmordner) {",
          "        $u = Join-Path $o 'uninstall.exe'",
          "        if (Test-Path -LiteralPath $u) { Schreibe ('Starte ' + $u + ' /S'); Schreibe ('beendet mit Code ' + (Starte $u '/S')) }",
          "    }",
          "}",
          "",
          "# 4. Warten, bis die Deinstallation durch ist (bis zu 2 Minuten)",
          "for ($i = 0; $i -lt 24; $i++) {",
          "    if (@(Finde-Eintraege).Count -eq 0) { break }",
          "    Start-Sleep -Seconds 5",
          "}",
          "",
          "# 5. Reste entfernen",
          "Stoppe-TeamViewer",
          "foreach ($d in Finde-Dienste) {",
          "    Schreibe ('Loesche Dienst: ' + $d.Name)",
          "    & sc.exe delete $d.Name | Out-Null",
          "}",
          "foreach ($a in @(Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskName -like '*TeamViewer*' -or $_.TaskPath -like '*TeamViewer*' })) {",
          "    try { Unregister-ScheduledTask -TaskName $a.TaskName -TaskPath $a.TaskPath -Confirm:$false -ErrorAction Stop; Schreibe ('Aufgabe entfernt: ' + $a.TaskPath + $a.TaskName) }",
          "    catch { Schreibe ('Aufgabe nicht entfernt: ' + $a.TaskName + ': ' + $_.Exception.Message) }",
          "}",
          "foreach ($o in Programmordner) { Entferne $o }",
          "if ($einstellungenLoeschen) {",
          "    Entferne 'HKLM:\\SOFTWARE\\TeamViewer'",
          "    Entferne 'HKLM:\\SOFTWARE\\WOW6432Node\\TeamViewer'",
          "    foreach ($sid in Benutzer-Hives) { Entferne ('Registry::HKEY_USERS\\' + $sid + '\\Software\\TeamViewer') }",
          "    $benutzerOrdner = Get-ChildItem -LiteralPath (Join-Path $env:SystemDrive 'Users') -Directory -ErrorAction SilentlyContinue |",
          "        Where-Object { @('Public', 'Default', 'Default User', 'All Users') -notcontains $_.Name }",
          "    foreach ($pr in $benutzerOrdner) {",
          "        Entferne (Join-Path $pr.FullName 'AppData\\Roaming\\TeamViewer')",
          "        Entferne (Join-Path $pr.FullName 'AppData\\Local\\TeamViewer')",
          "    }",
          "}",
          "",
          "# 6. Pruefen",
          "$restE = @(Finde-Eintraege)",
          "$restD = @(Finde-Dienste)",
          "foreach ($e in $restE) { Schreibe ('Noch in der Softwareliste: ' + $e.DisplayName + ' [' + $e.PSChildName + ']') }",
          "foreach ($d in $restD) { Schreibe ('Dienst noch vorhanden: ' + $d.Name) }",
          "if ($restE.Count -gt 0 -or $restD.Count -gt 0) { Schreibe 'FEHLER 5: TeamViewer ist nicht vollstaendig entfernt.'; exit 5 }",
          "Schreibe 'TeamViewer ist deinstalliert.'",
          "exit 0"
        ],
        "ExitCode": "UNINSTALL_EXITCODE",
        "OutputLines": "",
        "ShowConsole": "False",
        "Use64Bit": "True",
        "RunAsGlobalAccount": "False",
        "RunAsDifferentUser": "False",
        "RunAsRequestElevatedRights": "False",
        "RunAsGlobalAccountId": "",
        "RunAsUsername": "",
        "RunAsPassword": ""
      }
    },
    {
      "class": "TActionIf",
      "description": "Wenn nicht erfolgreich deinstalliert",
      "fields": {
        "Value_1": "%UNINSTALL_EXITCODE%",
        "Value_2": "0",
        "Operator": "<>",
        "CaseSensitive": "False",
        "DigitsAsNumbers": "False"
      },
      "children": [
        {
          "class": "TActionIf",
          "description": "und TeamViewer auch nicht fehlte",
          "fields": {
            "Value_1": "%UNINSTALL_EXITCODE%",
            "Value_2": "20",
            "Operator": "<>",
            "CaseSensitive": "False",
            "DigitsAsNumbers": "False"
          },
          "children": [
            {
              "class": "TActionExitScript",
              "description": "Command mit Fehler beenden",
              "fields": {
                "Result": "1",
                "Reason": "TeamViewer-Deinstallation fehlgeschlagen, Code %UNINSTALL_EXITCODE%, Protokoll C:\\Windows\\Temp\\acmp-teamviewer-uninstall.log"
              }
            }
          ]
        }
      ]
    }
  ],
  "files": []
}
