        {
          "class": "TExecutePowerShell",
          "description": "ChatGPT beim angemeldeten Benutzer registrieren (als Benutzer)",
          "fields": {
            "_CommandComment": "Läuft als angemeldeter Benutzer. Macht die bereitgestellte App sofort sichtbar. Rückgabe in REG_EXITCODE (0 sichtbar, 10 erst nach Neuanmeldung).",
            "isSystem": "False",
            "BatchLines": [
              "# ChatGPT fuer den angemeldeten Benutzer sofort sichtbar machen",
              "# Laeuft als angemeldeter Benutzer (ACMP \"Ausfuehren als: Benutzer\"), direkt nach der Bereitstellung als SYSTEM.",
              "# Ohne diesen Schritt erscheint die App erst nach dem naechsten Anmelden im Startmenue.",
              "# Hinweis: keine Prozentzeichen verwenden, ACMP ersetzt sie durch Variablen.",
              "#",
              "# Rueckgabe: 0 App ist beim Benutzer registriert, 10 noch nicht (Benutzer muss sich ab- und wieder anmelden).",
              "# Protokoll: TEMP-Ordner des Benutzers, acmp-chatgpt-register.log",
              "",
              "$paketName = 'OpenAI.Codex'",
              "$familie   = 'OpenAI.Codex_2p2nqsd0c76g0'",
              "",
              "$logDatei = Join-Path $env:TEMP 'acmp-chatgpt-register.log'",
              "function Schreibe([string]$text) {",
              "    [Console]::Out.WriteLine($text)",
              "    try { Add-Content -LiteralPath $logDatei -Value ((Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + '  ' + $text) -Encoding UTF8 } catch { }",
              "}",
              "",
              "Schreibe ('Start fuer ' + $env:USERDOMAIN + '\\' + $env:USERNAME)",
              "# Schon vorhanden: nichts tun (eine laufende App nicht anfassen, Updates holt sie sich selbst)",
              "$app = Get-AppxPackage -Name $paketName -ErrorAction SilentlyContinue | Select-Object -First 1",
              "if ($app) { Schreibe ('Schon beim Benutzer vorhanden: ' + $app.PackageFullName); exit 0 }",
              "",
              "try {",
              "    Add-AppxPackage -RegisterByFamilyName -MainPackage $familie -ErrorAction Stop",
              "    Schreibe ('Registriert: ' + $familie)",
              "} catch {",
              "    Schreibe ('Registrieren nicht moeglich: ' + $_.Exception.Message)",
              "}",
              "$app = Get-AppxPackage -Name $paketName -ErrorAction SilentlyContinue | Sort-Object { [version]$_.Version } -Descending | Select-Object -First 1",
              "if ($app) {",
              "    Schreibe ('Beim Benutzer vorhanden: ' + $app.PackageFullName)",
              "    exit 0",
              "}",
              "Schreibe 'Noch nicht beim Benutzer vorhanden, erscheint nach dem naechsten Anmelden.'",
              "exit 10"
            ],
            "ExitCode": "REG_EXITCODE",
            "OutputLines": "",
            "ShowConsole": "False",
            "Use64Bit": "True",
            "RunAsGlobalAccount": "False",
            "RunAsDifferentUser": "False",
            "RunAsRequestElevatedRights": "False",
            "RunAsGlobalAccountId": "",
            "RunAsUsername": "",
            "RunAsPassword": ""
          }
        }
      ]
    },
    {
      "class": "THideProgressForm",
      "description": "Fortschrittsfenster schließen",
      "fields": {
        "Ignore_error": "True",
        "isSystem": "False"
      }
