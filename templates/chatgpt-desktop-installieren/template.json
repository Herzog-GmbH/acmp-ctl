      "name": "REG_EXITCODE",
      "value": "-1"
    },
    {
      "name": "SETUP_EXITCODE",
      "value": "-1"
    }
  ],
  "steps": [
    {
      "class": "TShowProgressForm",
      "description": "Fortschrittsfenster zeigen",
      "fields": {
        "Ignore_error": "True",
        "isSystem": "False"
      }
    },
    {
      "class": "TSetProgressFormProperties",
      "description": "Fortschritt: ChatGPT wird geladen",
      "fields": {
        "Ignore_error": "True",
        "isSystem": "False",
        "Line1": "ChatGPT wird heruntergeladen und installiert …",
        "Line2": "Das kann einige Minuten dauern.",
        "Image_file": "",
        "Form_caption": "ChatGPT wird installiert",
        "Image_string": "",
        "Transparent": "False",
        "Value_progressbar": "30",
        "Update_line1": "True",
        "Update_line2": "True",
        "Update_Caption": "True",
        "Image_type": "0"
      }
    },
    {
      "class": "TExecutePowerShell",
      "description": "ChatGPT für alle Benutzer bereitstellen (als SYSTEM)",
      "fields": {
        "_CommandComment": "Läuft als SYSTEM. Lädt das aktuelle MSIX und die Offline-Lizenz beim Hersteller, prüft Signatur, Paket und Lizenz und stellt es mit Add-AppxProvisionedPackage bereit. Rückgabe in SETUP_EXITCODE.",
        "BatchLines": [
          "# ChatGPT Desktop fuer alle Benutzer installieren (MSIX aus dem Microsoft Store, offline bereitgestellt)",
          "#",
          "# Laeuft als SYSTEM ueber ACMP (64-Bit-PowerShell).",
          "# Hinweis: keine Prozentzeichen verwenden, ACMP ersetzt sie durch Variablen.",
          "#",
          "# Ablauf:",
          "#  1. Windows-Version, Prozessor und freien Platz pruefen",
          "#  2. aktuelles MSIX und Offline-Lizenz direkt bei OpenAI laden (offizielle Adressen fuer Unternehmensinstallationen)",
          "#  3. Signatur, Paketkennung und Lizenz pruefen (Paket OpenAI.Codex, Store-Produkt 9PLM9XGG6VKS)",
          "#  4. mit Add-AppxProvisionedPackage fuer alle Benutzer bereitstellen",
          "#  5. Bereitstellung pruefen, Download loeschen",
          "# Updates holt sich die App danach selbst (ueber persistent.oaistatic.com).",
          "# Das Paket heisst intern OpenAI.Codex, im Startmenue heisst die App ChatGPT.",
          "#",
          "# Rueckgabe: 0 fertig, 2 Windows oder Prozessor passt nicht, 3 Download fehlgeschlagen,",
          "#            4 Paket, Signatur oder Lizenz falsch, 5 Bereitstellung fehlgeschlagen, 6 zu wenig Speicherplatz,",
          "#            1 sonstiger Fehler.",
          "# Protokoll: C:\\Windows\\Temp\\acmp-chatgpt-setup.log",
          "# Quelle: https://learn.chatgpt.com/docs/enterprise/windows-deployment",
          "",
          "$appName     = 'ChatGPT'",
          "$paketName   = 'OpenAI.Codex'",
          "$familie     = 'openai.codex_2p2nqsd0c76g0'",
          "$produktId   = '9PLM9XGG6VKS'",
          "$herausgeber = 'CN=50BDFD77-8903-4850-9FFE-6E8522F64D5B'",
          "$urlX64      = 'https://persistent.oaistatic.com/codex-app-prod/ChatGPT-x64.msix'",
          "$urlArm64    = 'https://persistent.oaistatic.com/codex-app-prod/ChatGPT-arm64.msix'",
          "$urlLizenz   = 'https://persistent.oaistatic.com/codex-app-prod/ChatGPT-License.xml'",
          "$minBuild    = 19041",
          "$minFreiGB   = 6",
          "$nurPruefen  = $false   # true = laden und pruefen, aber nichts installieren",
          "",
          "$ErrorActionPreference = 'Stop'",
          "$ProgressPreference    = 'SilentlyContinue'",
          "$logDatei  = Join-Path $env:windir 'Temp\\acmp-chatgpt-setup.log'",
          "$arbeit    = Join-Path $env:windir 'Temp\\acmp-chatgpt-msix'",
          "if ($nurPruefen) {",
          "    $logDatei = Join-Path $env:TEMP 'acmp-chatgpt-setup-probe.log'",
          "    $arbeit   = Join-Path $env:TEMP 'acmp-chatgpt-msix-probe'",
          "}",
          "",
          "function Schreibe([string]$text) {",
          "    [Console]::Out.WriteLine($text)",
          "    try { Add-Content -LiteralPath $logDatei -Value ((Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + '  ' + $text) -Encoding UTF8 } catch { }",
          "}",
          "function Aufraeumen {",
          "    if (Test-Path -LiteralPath $arbeit) { Remove-Item -LiteralPath $arbeit -Recurse -Force -ErrorAction SilentlyContinue }",
          "}",
          "function Abbruch([int]$code, [string]$text) {",
          "    Schreibe ('FEHLER ' + $code + ': ' + $text)",
          "    Aufraeumen",
          "    exit $code",
          "}",
          "trap { Schreibe ('FEHLER 1: ' + $_.Exception.Message); Aufraeumen; exit 1 }",
          "",
          "Schreibe ('Start auf ' + $env:COMPUTERNAME + ($(if ($nurPruefen) { ' (nur pruefen)' } else { '' })))",
          "",
          "# 1. Windows, Prozessor, Speicherplatz",
          "$build = [int](Get-CimInstance -ClassName Win32_OperatingSystem).BuildNumber",
          "if ($build -lt $minBuild) { Abbruch 2 ('Windows-Build ' + $build + ' ist zu alt, noetig ist mindestens ' + $minBuild + '.') }",
          "switch ($env:PROCESSOR_ARCHITECTURE) {",
          "    'AMD64' { $url = $urlX64 }",
          "    'ARM64' { $url = $urlArm64 }",
          "    default { Abbruch 2 ('Prozessor ' + $env:PROCESSOR_ARCHITECTURE + ' wird nicht unterstuetzt (nur 64-Bit-PowerShell auf x64 oder Arm64).') }",
          "}",
          "$laufwerk = New-Object System.IO.DriveInfo ($env:SystemDrive)",
          "$freiGB = [math]::Round($laufwerk.AvailableFreeSpace / 1GB, 1)",
          "if ($freiGB -lt $minFreiGB) { Abbruch 6 ('Nur ' + $freiGB + ' GB frei auf ' + $env:SystemDrive + ', noetig sind ' + $minFreiGB + ' GB.') }",
          "Schreibe ('Windows-Build ' + $build + ', ' + $env:PROCESSOR_ARCHITECTURE + ', ' + $freiGB + ' GB frei')",
          "",
          "# 2. Download (Paket und Lizenz)",
          "Aufraeumen",
          "New-Item -ItemType Directory -Path $arbeit -Force | Out-Null",
          "$datei  = Join-Path $arbeit ($appName + '.msix')",
          "$lizenz = Join-Path $arbeit ($appName + '-License.xml')",
          "[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12",
          "$uhr = [Diagnostics.Stopwatch]::StartNew()",
          "foreach ($teil in @(@($url, $datei), @($urlLizenz, $lizenz))) {",
          "    try {",
          "        $wc = New-Object System.Net.WebClient",
          "        $wc.Headers.Add('User-Agent', 'ACMP-Client-Command/1.0')",
          "        $wc.DownloadFile($teil[0], $teil[1])",
          "        $wc.Dispose()",
          "    } catch {",
          "        Abbruch 3 ('Download von ' + $teil[0] + ' fehlgeschlagen: ' + $_.Exception.Message)",
          "    }",
          "}",
          "$mb = [math]::Round((Get-Item -LiteralPath $datei).Length / 1MB, 1)",
          "Schreibe ('Geladen: ' + $mb + ' MB in ' + [math]::Round($uhr.Elapsed.TotalSeconds) + ' s von ' + $url)",
          "",
          "# 3. Signatur, Paketkennung und Lizenz",
          "$sig = Get-AuthenticodeSignature -LiteralPath $datei",
          "if ($sig.Status -ne 'Valid') { Abbruch 4 ('Signatur ungueltig: ' + $sig.Status + ' ' + $sig.StatusMessage) }",
          "if ($sig.SignerCertificate.Subject -ne $herausgeber) { Abbruch 4 ('Unerwarteter Signierer: ' + $sig.SignerCertificate.Subject) }",
          "Add-Type -AssemblyName System.IO.Compression.FileSystem",
          "$zip = [IO.Compression.ZipFile]::OpenRead($datei)",
          "try {",
          "    $eintrag = $zip.GetEntry('AppxManifest.xml')",
          "    if (-not $eintrag) { Abbruch 4 'AppxManifest.xml fehlt im Paket.' }",
          "    $leser = New-Object System.IO.StreamReader ($eintrag.Open())",
          "    $manifest = [xml]$leser.ReadToEnd()",
          "    $leser.Dispose()",
          "} finally { $zip.Dispose() }",
          "$kennung = $manifest.Package.Identity",
          "if ($kennung.Name -ne $paketName -or $kennung.Publisher -ne $herausgeber) { Abbruch 4 ('Falsches Paket: ' + $kennung.Name + ' / ' + $kennung.Publisher) }",
          "$version = $kennung.Version",
          "try { $lx = [xml](Get-Content -LiteralPath $lizenz -Raw) } catch { Abbruch 4 'Lizenzdatei ist kein gueltiges XML.' }",
          "$bindung = $lx.License.Binding",
          "if ($bindung.ProductID -ne $produktId -or $bindung.PFM -ne $familie) { Abbruch 4 ('Lizenz passt nicht zum Paket: ' + $bindung.ProductID + ' / ' + $bindung.PFM) }",
          "Schreibe ('Paket ' + $kennung.Name + ' ' + $version + ' (' + $kennung.ProcessorArchitecture + '), Signatur und Lizenz gueltig')",
          "",
          "# 4. Fuer alle Benutzer bereitstellen",
          "if ($nurPruefen) {",
          "    Schreibe ('Probe: ' + $datei + ' wuerde jetzt mit Lizenz fuer alle Benutzer bereitgestellt.')",
          "    Aufraeumen",
          "    exit 0",
          "}",
          "try {",
          "    Add-AppxProvisionedPackage -Online -PackagePath $datei -LicensePath $lizenz -Regions 'all' | Out-Null",
          "} catch {",
          "    Abbruch 5 ('Add-AppxProvisionedPackage: ' + $_.Exception.Message)",
          "}",
          "",
          "# 5. Pruefen und aufraeumen",
          "$bereit = @(Get-AppxProvisionedPackage -Online | Where-Object { $_.DisplayName -eq $paketName -and [version]$_.Version -ge [version]$version })",
          "if ($bereit.Count -eq 0) { Abbruch 5 ('Nach der Bereitstellung fehlt ' + $paketName + ' ' + $version + ' in der Liste.') }",
          "Schreibe ('Bereitgestellt: ' + $bereit[0].PackageName)",
          "Aufraeumen",
          "Schreibe 'Fertig.'",
          "exit 0"
        ],
        "ExitCode": "SETUP_EXITCODE",
        "OutputLines": "",
        "ShowConsole": "False",
        "Use64Bit": "True",
        "RunAsGlobalAccount": "False",
        "RunAsDifferentUser": "False",
        "RunAsRequestElevatedRights": "False",
        "RunAsGlobalAccountId": "",
        "RunAsUsername": "",
        "RunAsPassword": ""
      }
    },
    {
      "class": "TActionIf",
      "description": "Wenn die Bereitstellung geklappt hat",
