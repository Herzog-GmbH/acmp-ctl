          "class": "TActionIf",
          "description": "Wenn es nicht installiert war",
          "fields": {
            "Value_1": "%UNINSTALL_EXITCODE%",
            "Value_2": "20",
            "Operator": "=",
            "CaseSensitive": "False",
            "DigitsAsNumbers": "False"
          },
          "children": [
            {
              "class": "TActionIf",
              "description": "Wenn Hinweise an den Benutzer gewünscht sind",
              "fields": {
